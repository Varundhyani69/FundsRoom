# Copy this to .env.prod on your EC2 and fill in values
DB_ROOT_PASSWORD=change_this_root_password
DB_USER=erp_user
DB_PASSWORD=change_this_db_password
JWT_SECRET=a_random_string_at_least_32_characters_long
# Set this to your Vercel frontend URL after deploying frontend
CORS_ORIGIN=https://your-app.vercel.app
