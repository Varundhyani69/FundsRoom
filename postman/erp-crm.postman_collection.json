                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/products",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"New Bearing 6300\",\n  \"sku\": \"BRG-6300\",\n  \"category\": \"Bearings\",\n  \"unit_price\": 175.00,\n  \"current_stock\": 100,\n  \"min_stock_alert\": 20,\n  \"warehouse\": \"Warehouse A\"\n}"
                        }
                    }
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/products/1",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Industrial Bearing 6205\",\n  \"sku\": \"BRG-6205\",\n  \"category\": \"Bearings\",\n  \"unit_price\": 150.00,\n  \"min_stock_alert\": 50,\n  \"warehouse\": \"Warehouse A\"\n}"
                        }
                    }
                },
                {
                    "name": "Adjust Stock (IN)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/products/1/stock-adjust",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quantity\": 50,\n  \"movement_type\": \"IN\",\n  \"reason\": \"Purchase order received\"\n}"
                        }
                    }
                },
                {
                    "name": "Adjust Stock (OUT)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/products/1/stock-adjust",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quantity\": 10,\n  \"movement_type\": \"OUT\",\n  \"reason\": \"Damaged goods removed\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Stock Movements",
            "item": [
                {
                    "name": "List Stock Movements",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/stock-movements?page=1&limit=15",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "stock-movements"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "15"
                                },
                                {
                                    "key": "product_id",
                                    "value": "1",
                                    "disabled": true
                                },
                                {
                                    "key": "movement_type",
                                    "value": "OUT",
                                    "disabled": true
                                }
                            ]
                        },
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "Challans",
            "item": [
                {
                    "name": "List Challans",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/challans?page=1&limit=10",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "challans"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "status",
                                    "value": "draft",
                                    "disabled": true
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "disabled": true
                                }
                            ]
                        },
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ]
                    }
                },
                {
                    "name": "Get Challan by ID",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/challans/1",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ]
                    }
                },
                {
                    "name": "Create Challan (Draft)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/challans",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"customer_id\": 1,\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 10 },\n    { \"product_id\": 2, \"quantity\": 5 }\n  ],\n  \"status\": \"draft\",\n  \"notes\": \"Pending customer confirmation\"\n}"
                        }
                    }
                },
                {
                    "name": "Create Challan (Confirmed)",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/challans",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"customer_id\": 2,\n  \"items\": [\n    { \"product_id\": 3, \"quantity\": 5 }\n  ],\n  \"status\": \"confirmed\",\n  \"notes\": \"Urgent delivery\"\n}"
                        }
                    }
                },
                {
                    "name": "Confirm Challan",
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/challans/1/confirm",
